NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required by native/static builds.
# Use the public HTTPS origin of the deployed School HQ backend (no /api suffix).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Development builds only. Never enable this in an App Store or public web build.
NEXT_PUBLIC_ENABLE_NATIVE_DEV_AUTH=false
BACKEND_INTERNAL_URL=http://127.0.0.1:3001
