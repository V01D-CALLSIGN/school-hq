# Public Supabase project configuration (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set to "mock" for deterministic local/test parsing, or "openai" in production.
BRAIN_DUMP_PARSER=mock
BRAIN_DUMP_TIMEOUT_MS=12000
BRAIN_DUMP_RATE_LIMIT_PER_MINUTE=10

# Used by local tooling only. Obtain it from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
