# Public Supabase project configuration (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated browser/WebView origins allowed to call /api directly.
# Defaults already include capacitor://localhost for the School HQ iOS app.
CORS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost

# Local, server-side parser configuration. Never call Ollama from browser code.
BRAIN_DUMP_PARSER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# For Ollama Cloud, use https://ollama.com, a supported cloud model, and keep
# the API key server-side. Local Ollama does not require this key.
OLLAMA_API_KEY=

BRAIN_DUMP_TIMEOUT_MS=60000
BRAIN_DUMP_RATE_LIMIT_PER_MINUTE=10

# Optional hosted provider. Only required when BRAIN_DUMP_PARSER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Used by local tooling only. Obtain it from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
